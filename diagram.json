{
  "version": 1,
  "author": "Karen",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 120, "attrs": { "color": "blue" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 120, "attrs": { "value": "330" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 50, "left": 150, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:2", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "esp:GND.1", "led1:C", "black", [ "v0" ] ],
    [ "esp:33", "btn1:1.l", "green", [ "v0" ] ],
    [ "esp:GND.2", "btn1:2.r", "black", [ "v0" ] ]
  ]
}